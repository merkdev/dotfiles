#!/bin/sh
# Linked into ~/.local/bin as both `npm` and `npx`, which sits ahead of nvm on
# PATH: this machine uses pnpm. ALLOW_NPM=1 runs the real one for the rare tool
# that shells out to npm on purpose.
set -eu

tool="${0##*/}"
if [ "$tool" = npx ]; then alt="pnpx"; else alt="pnpm"; fi

if [ -n "${ALLOW_NPM:-}" ]; then
	# npm and npx always ship beside the node that owns them, so this follows
	# whatever version nvm has switched to.
	node="$(command -v node)" || { echo "$tool: no node on PATH" >&2; exit 127; }
	exec "$(dirname "$node")/$tool" "$@"
fi

echo "$tool is disabled on this machine — use $alt instead." >&2
echo "  ALLOW_NPM=1 $tool $* to run it anyway" >&2
exit 127
