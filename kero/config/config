# Kero's configuration, as Ghostty's: one setting a line, `key = value`.
# It holds what differs from the defaults. Kero's Settings window edits
# it in place, keeping your comments; what you save here applies at once.
# `kero config show` lists every key, with its default.

new-session-directory = project
theme = light:Monokai Pro Light,dark:Monokai Pro
diff-layout = unified
font-size = 13
macos-show-app-icon = dock
window-translucent = true
font-thicken = false
dim-unfocused-terminals = false
cursor-style-blink = false
notify-sound = true
dock-bounce = false
sidebar-rows = compact
git-status = true
focus-follows-mouse = false
wrap-lines = false
